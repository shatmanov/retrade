{
    "manifest_version": 3,
    "name": "ReTrade",
    "short_name": "ReTrade",
    "version": "0.0.2",
    "description": "Показывает ценность карт ReManga для обмена.",
    "permissions": [
        "storage"
    ],
    "host_permissions": [
        "https://remanga.org/*",
        "https://xn--80aaig9ahr.xn--c1avg/*",
        "https://api.remanga.org/*",
        "https://api.xn--80aaig9ahr.xn--c1avg/*"
    ],
    "options_ui": {
        "page": "options.html",
        "open_in_tab": true
    },
    "content_scripts": [
        {
            "matches": [
                "https://remanga.org/*",
                "https://xn--80aaig9ahr.xn--c1avg/*"
            ],
            "js": [
                "src/config.js",
                "src/content.js"
            ],
            "css": [
                "src/content.css"
            ],
            "run_at": "document_start"
        },
        {
            "matches": [
                "https://remanga.org/*",
                "https://xn--80aaig9ahr.xn--c1avg/*"
            ],
            "js": [
                "src/interceptor.js"
            ],
            "world": "MAIN",
            "run_at": "document_start"
        }
    ],
    "action": {
        "default_title": "ReTrade",
        "default_popup": "popup.html",
        "default_icon": {
            "16": "icons/icon16.png",
            "32": "icons/icon32.png",
            "48": "icons/icon48.png"
        }
    },
    "icons": {
        "16": "icons/icon16.png",
        "32": "icons/icon32.png",
        "48": "icons/icon48.png",
        "128": "icons/icon128.png"
    }
}
